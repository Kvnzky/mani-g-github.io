# Server Port
PORT=3001

# Admin Authentication (Change in production)
ADMIN_USERNAME=kvn000
# Bcrypt hash of admin password (cost factor 12)
ADMIN_PASSWORD_HASH=$2b$12$Ixrfw9ET7VnACOwVu72La.8Xgf/9gEDgU9DbcDmH3Av8wJi7sojq2
# Cryptographically secure 64-character hex secret for signing JWT admin tokens
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Business Timezone
